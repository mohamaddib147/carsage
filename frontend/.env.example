# Supabase project connection (safe to expose in frontend — anon key is public-facing)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Base URL of the deployed FastAPI service
VITE_API_BASE_URL=http://localhost:8000

# Browser-exposed Google Maps key (CAR-47 address autocomplete, CAR-48
# static route map). Enable "Places API (New)" and "Maps Static API", and
# restrict it by HTTP referrer (e.g. http://localhost:5173/*) in Google
# Cloud Console - it is visible in the page source. Leave blank to fall
# back to plain text fields / no map.
VITE_GOOGLE_MAPS_API_KEY=your_browser_google_maps_key
