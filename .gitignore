# Environment variables — never commit real secrets. Every .env.<anything>
# (.env.production, .env.staging, ... — Vite loads one per mode) is ignored;
# only the placeholder templates are kept.
.env
.env.*
!.env.example

# Private keys / certificates
*.pem
*.key

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build output
dist/
build/
.next/

# Editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Python
*.egg-info/
.pytest_cache/

# Claude Code local config/artifacts — never share these
.claude/
.claude.json
CLAUDE.local.md
.mcp.json